#!/usr/bin/env bash
# Block commit messages that contain AI attribution markers.
# AI-written commit history is misleading and against team norms.
#
# Override: AI_ATTR_OK=1 git commit

[[ -n "${AI_ATTR_OK:-}" ]] && exit 0

patterns=(
    "Generated by Claude"
    "Generated by GitHub Copilot"
    "Generated by AI"
    "Co-authored-by: Claude"
    "Co-authored-by: GitHub Copilot"
    "🤖 Generated"
    "AI-generated"
)

for pattern in "${patterns[@]}"; do
    if grep -qiF "$pattern" "$1"; then
        echo ""
        echo "🚫  commit-msg: AI attribution found in commit message"
        printf '    Pattern: "%s"\n' "$pattern"
        echo "    Remove it or override with: AI_ATTR_OK=1 git commit"
        echo ""
        exit 1
    fi
done

exit 0
