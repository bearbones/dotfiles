# ~/.zshrc for personal machines (linked by `install.sh --shell`).
# Work machines keep their own zshrc and source shell/*.sh from it.

DOTFILES="$HOME/dotfiles"
. "$DOTFILES/shell/common.sh"

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE EXTENDED_HISTORY

setopt AUTO_CD INTERACTIVE_COMMENTS
bindkey -e

autoload -Uz compinit && compinit
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'

# fzf key bindings (Ctrl-R history, Ctrl-T files) — Debian/Ubuntu path.
[ -f /usr/share/doc/fzf/examples/key-bindings.zsh ] && . /usr/share/doc/fzf/examples/key-bindings.zsh
command -v fd >/dev/null && export FZF_DEFAULT_COMMAND='fd --type f --hidden --exclude .git'

# Plugins from apt; syntax highlighting must load last.
[ -f /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh ] && . /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
command -v starship >/dev/null && eval "$(starship init zsh)"
[ -f /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh ] && . /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh

[ -f "$HOME/.zshrc.local" ] && . "$HOME/.zshrc.local"
